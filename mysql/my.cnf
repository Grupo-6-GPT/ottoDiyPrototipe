[mysqld]
# Reduce InnoDB buffer pool — the biggest memory consumer in MySQL 8
innodb_buffer_pool_size     = 64M
innodb_log_buffer_size      = 4M
innodb_redo_log_capacity    = 32M

# Limit connections (app only needs a handful)
max_connections             = 20

# Reduce per-thread buffers
sort_buffer_size            = 256K
read_buffer_size            = 128K
read_rnd_buffer_size        = 256K
join_buffer_size            = 128K
thread_stack                = 192K

# Smaller table cache
table_open_cache            = 32
table_definition_cache      = 64

# Key buffer (for MyISAM, minimal since we use InnoDB)
key_buffer_size             = 4M

# Disable performance_schema to save ~50-80 MB
performance_schema          = OFF
